[Unit]
Description=NarratorHotkey text-to-speech daemon
Documentation=https://github.com/gravypower/NarratorHotkey

# Give up if the daemon fails repeatedly rather than respawning forever, as it
# would when something else holds its port. These two belong to [Unit]; systemd
# ignores them, with a warning, under [Service].
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# @INSTALL_DIR@ is substituted by install.sh.
ExecStart=@INSTALL_DIR@/NarratorHotkey --daemon
# A second instance finds the lock held and exits cleanly, which on-failure does
# not restart, so there is no restart loop against a running daemon.
Restart=on-failure
RestartSec=2

[Install]
# default.target rather than graphical-session.target: the latter is only reached
# once a desktop environment binds it, and several session managers never do.
# Audio does not need to be up at start, only when something is spoken.
WantedBy=default.target
