<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0-windows10.0.19041.0;net10.0</TargetFrameworks>
        <ApplicationIcon>icon.ico</ApplicationIcon>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <LangVersion>latest</LangVersion>
        <StartupObject>NarratorHotkey.Program</StartupObject>
        <RollForward>Major</RollForward>
    </PropertyGroup>

    <ItemGroup>
        <None Update="icon.ico">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
        <OutputType>WinExe</OutputType>
        <UseWindowsForms>true</UseWindowsForms>
        <UseWPF>true</UseWPF>
        <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.8" />
        <!-- 1.0.7 or later: earlier versions pull in SharpCompress 0.36.0, which is open
             to path traversal on extraction (GHSA-6c8g-7p36-r338). -->
        <PackageReference Include="PiperSharp" Version="1.0.7" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
        <PackageReference Include="System.Speech" Version="9.0.6" />
    </ItemGroup>

    <!-- Exclude Windows-specific files when target is net10.0 -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <Compile Remove="AssemblyInfo.cs" />
        <Compile Remove="TrayApplication.cs" />
        <Compile Remove="Speech/WindowsTTSProvider.cs" />
        <Compile Remove="Speech/Synthesize.cs" />
        <Compile Remove="HotkeyManager.cs" />
        <Compile Remove="Interoperability.cs" />
    </ItemGroup>

</Project>